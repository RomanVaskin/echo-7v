# Enquiry delivery: the form sends each enquiry to this Telegram chat.
# Create a bot with @BotFather, add it to the team chat, and set both values
# on Vercel (Project → Settings → Environment Variables) and on the VPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bookings and payments (journeys/caribbean/book) — see docs/payments.md
# PostgreSQL; create the tables with `pnpm db:migrate`
DATABASE_URL=
# PayPal REST app (SANDBOX credentials only; live stays off until approved)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered for https://<site>/api/payments/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Public address of the site, used in PayPal return links and emails
SITE_URL=
# Bearer secrets for the scheduled jobs and the staff refund endpoint
CRON_SECRET=
ADMIN_API_TOKEN=
# Mail service not chosen yet: 'log' keeps emails in the email_log table
EMAIL_TRANSPORT=log
